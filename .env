# Coloque estas variáveis na Vercel: Settings -> Environment Variables
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=            # texto aleatório longo (ex.: 40+ caracteres)
ADMIN_IDS=                 # IDs do Discord dos admins, separados por vírgula
MC_IP=
MC_PORT=
MC_VERSION=
# Criadas automaticamente ao conectar o Upstash Redis / Vercel Blob no projeto:
# KV_REST_API_URL, KV_REST_API_TOKEN, BLOB_READ_WRITE_TOKEN