{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}